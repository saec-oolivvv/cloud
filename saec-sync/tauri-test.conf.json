{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "me.saec.sync",
  "productName": "SAEC Sync",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SAEC Sync",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://cloud.saec.me wss://cloud.saec.me; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "copyright": "© 2026 SAEC Ltd.",
    "category": "Productivity",
    "shortDescription": "SAEC Cloud Desktop Sync Client",
    "longDescription": "Synchronize your files with SAEC Cloud storage providers.",
    "license": "MIT",
    "licenseFile": ""
  }
}
