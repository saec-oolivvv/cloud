{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAEC Sync",
  "version": "0.1.36",
  "identifier": "me.saec.sync",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SAEC Sync",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; connect-src ipc: http://ipc.localhost 'self' https://cloud.saec.me wss://cloud.saec.me; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "msi", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": [],
    "externalBin": [],
    "copyright": "© 2026 SAEC Ltd.",
    "category": "Productivity",
    "shortDescription": "SAEC Cloud Desktop Sync Client",
    "longDescription": "Synchronize your files with SAEC Cloud storage providers.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"],
        "section": "utils",
        "priority": "optional"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "libayatana-appindicator-gtk3"]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": ["https://releases.saec.me/{{target}}/{{current_version}}"],
      "dialog": true,
      "pubkey": ""
    }
  }
}